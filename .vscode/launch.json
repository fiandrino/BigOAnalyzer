{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "BigOAnalyzer - Terminale integrato",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/BigOAnalyzer/bin/Debug/net10.0/BigOAnalyzer.dll",
            "cwd": "${workspaceFolder}/BigOAnalyzer",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "requireExactSource": false
        },
        {
            "name": "BigOAnalyzer - Debug Console",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/BigOAnalyzer/bin/Debug/net10.0/BigOAnalyzer.dll",
            "cwd": "${workspaceFolder}/BigOAnalyzer",
            "console": "internalConsole",
            "stopAtEntry": false,
            "requireExactSource": false
        },
        {
            "name": "BigOAnalyzer - Finestra esterna",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/BigOAnalyzer/bin/Debug/net10.0/BigOAnalyzer.dll",
            "cwd": "${workspaceFolder}/BigOAnalyzer",
            "console": "externalTerminal",
            "stopAtEntry": false,
            "requireExactSource": false
        }
    ]
}
